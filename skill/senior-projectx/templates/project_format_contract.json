{
  "schema": "senior_projectx.project.format.v1",
  "page": {
    "size": "A4",
    "orientation": "portrait",
    "margins_cm": {"top": 2.5, "bottom": 2.5, "left": 2.8, "right": 2.6}
  },
  "body": {
    "chinese_font": "SimSun",
    "latin_and_number_font": "Times New Roman",
    "size_pt": 12,
    "line_spacing": 1.5,
    "line_spacing_rule": "multiple",
    "first_line_indent_chars": 2,
    "color": "000000",
    "bold": false
  },
  "headings": {"chinese_font": "SimSun", "latin_and_number_font": "Times New Roman", "color": "000000", "bold": false},
  "tables": {
    "chinese_font": "SimSun", "latin_and_number_font": "Times New Roman",
    "size_pt": 10.5, "line_spacing": 1, "line_spacing_rule": "multiple",
    "first_line_indent_chars": 0, "color": "000000", "bold": false,
    "borders": "black_three_horizontal_rules", "shading": "none"
  },
  "equation_backend_default": "mathtype_native",
  "equation_size_pt": 12,
  "display_equations": {
    "alignment": "actual_object_centered_in_current_text_area",
    "numbering": "continuous_numeric", "number_position": "right_margin",
    "number_font": "Times New Roman", "number_size_pt": 12,
    "number_color": "000000", "number_bold": false,
    "number_field": "SEQ Equation", "usable_width": "current_section_not_fixed_tabs"
  },
  "inline_equations": {"numbered": false, "body_size_pt": 12, "table_size_pt": 10.5},
  "references": {
    "standard": "GB/T 7714", "edition": "verify_applicable_edition_at_delivery",
    "system": "sequential_first_citation", "alignment": "left_with_hanging_indent",
    "size_pt": 12, "line_spacing": 1.5, "color": "000000", "bold": false
  },
  "figures": {
    "chinese_font": "Microsoft YaHei", "chinese_weight": "bold",
    "latin_and_number_font": "Times New Roman", "fallback_must_be_recorded": true,
    "axis_label_pt": [9, 11], "tick_and_legend_pt": [8, 10],
    "default_total_title": false, "defensive_footer": false,
    "preserve_aspect_ratio": true, "inspect_at_final_insertion_size": true
  },
  "office_math_allowed_when_explicit": true,
  "explicit_current_user_requirements_precedence": true,
  "customer_template_precedence": true
}
